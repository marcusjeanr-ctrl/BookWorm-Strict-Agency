{
  "version": "2.2.5",
  "name": "BookWorm Strict Agency",
  "identifier": "lumiverse_bookworm",
  "description": "BookWorm natural immersive polish with strict player agency and unquoted dialogue.",
  "author": "angyaruo",
  "permissions": [
    "generation",
    "chats",
    "ui_panels",
    "web_search",
    "personas"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "github": "https://github.com/marcusjeanr-ctrl/BookWorm-Strict-Agency",
  "homepage": "https://github.com/marcusjeanr-ctrl/BookWorm-Strict-Agency",
  "storage_seed_files": [
    {
      "from": "data/lexicon/",
      "to": "lexicon/",
      "overwrite": true,
      "required": true
    },
    {
      "from": "licenses/",
      "to": "licenses/",
      "overwrite": true,
      "required": true
    }
  ]
}
